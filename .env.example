# ──────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in your values.
# ──────────────────────────────────────────────────────────────

# Store name shown in the header, page titles and emails.
SITE_NAME="Fieldhouse Goods"

# ── Admin authentication ──────────────────────────────────────
# The single password used to sign in at /login.
ADMIN_PASSWORD="change-me-to-something-long"

# Secret used to sign the session cookie (HS256 via jose).
# Generate one with:  openssl rand -base64 32
# If omitted, a key is derived from ADMIN_PASSWORD (changing the
# password then logs out every session).
SESSION_SECRET=""

# Session cookies are `Secure` in production by default. Set to "false"
# only if you serve the production build over plain HTTP (e.g. on a LAN).
# COOKIE_SECURE="true"

# ── Email (Nodemailer / SMTP) ─────────────────────────────────
# Where product inquiries are delivered.
ADMIN_EMAIL="you@example.com"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password-or-app-password"

# Optional. Defaults to true when SMTP_PORT is 465, otherwise STARTTLS is used.
# SMTP_SECURE="false"

# Optional "From" header. Many providers require it to match SMTP_USER.
# SMTP_FROM="Fieldhouse Goods <you@example.com>"

# ── Demo data ─────────────────────────────────────────────────
# Seed six sample products the first time the database is created.
SEED_DEMO_DATA="true"
